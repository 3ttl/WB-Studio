# This working directory also contains personal data and old release copies.
# The public candidate is assembled from build/public_files.json, not from all files.
/.dependencies/
/data/
/dist*/
/release-prep/
**/__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
.cache/
.env
.env.*
*.log
*.sqlite*
*.db
*.db-wal
*.db-shm
*.zip
*.tmp
*.ready.json
runtime_manifest.json
.DS_Store
Thumbs.db
Desktop.ini

# ImageJ and private Java binaries are supplied by the dependency ZIP.
/src/imagej/runtime/
/src/imagej/classes/
/src/imagej/ij.jar

# Only reviewed build entry points belong in the public repository.
/build/*
!/build/build_release.ps1
!/build/prepare_runtime.py
!/build/prepare_pdf_runtime.py
!/build/sync_app.py
!/build/sync_release_docs.py
!/build/package_release.py
!/build/prepare_github_release.py
!/build/finalize_github_release.py
!/build/public_files.json
!/build/release-readme.md
!/build/THIRD_PARTY_NOTICES.md
!/build/run_checks.ps1

# Retain synthetic tests; omit version-specific machine audits and their outputs.
/tests/*
!/tests/test_*.py
!/tests/test_*.js
!/tests/two_way_fixtures.json
!/tests/*DownloadProbe.cs
/tests/test_release_migration.py

# Older local inspection notes may contain private paths.
/docs/*
!/docs/用户使用指南.md
!/docs/GitHub发布准备.md
!/docs/构建说明.md
!/docs/发布验证.md
!/docs/v0.8.2更新说明.md
!/docs/RELEASE_NOTES_v0.8.2.md
!/docs/images/
